{
  "name": "@stambha/authz",
  "version": "1.3.1",
  "description": "Named capability authorization for Stambha — Discord permission floor, role grants, Vault claims",
  "author": "Mivaya",
  "license": "MIT",
  "homepage": "https://github.com/mivaya/Stambha/tree/main/packages/authz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mivaya/Stambha.git",
    "directory": "packages/authz"
  },
  "bugs": {
    "url": "https://github.com/mivaya/Stambha/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "stambha",
    "authz",
    "capabilities",
    "permissions"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@stambha/core": "workspace:*",
    "@stambha/vault": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@stambha/vault": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stambha/core": "workspace:*",
    "@stambha/vault": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
