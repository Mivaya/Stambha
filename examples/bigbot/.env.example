# Bot token (required for pnpm start)
DISCORD_TOKEN=

# Application ID from Discord Developer Portal (slash deploy / editReply)
DISCORD_APPLICATION_ID=

# Optional: guild-scoped slash deploy while testing
DISCORD_GUILD_ID=

# Optional: bot user id for mention demos without gateway ready
BOT_USER_ID=

# Optional: owner gate demos
OWNER_ID=
ENFORCE_OWNER=0
MAINTENANCE=0
DEMO=0

# Tier split (optional — pnpm split:*)
REST_WORKER_URL=http://127.0.0.1:4000
REST_WORKER_SECRET=
BOT_WORKER_URL=http://127.0.0.1:5000
BOT_WORKER_PORT=5000
WORKER_SECRET=
REST_PORT=4000
