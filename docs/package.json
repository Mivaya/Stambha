{
  "name": "@stambha/docs",
  "version": "0.2.1",
  "private": true,
  "description": "Stambha documentation site (VitePress)",
  "type": "module",
  "scripts": {
    "api": "node scripts/generate-api-docs.mjs",
    "dev": "node scripts/generate-api-docs.mjs --if-missing && vitepress dev",
    "build": "node scripts/generate-api-docs.mjs && vitepress build",
    "preview": "vitepress preview",
    "archive": "node scripts/archive-docs-version.mts"
  },
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.3",
    "vitepress-versioning-plugin": "^1.3.0",
    "vue": "^3.5.41"
  }
}
